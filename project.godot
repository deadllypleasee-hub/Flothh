; FORTIS GAMES — Godot 4.6.3, Compatibility / OpenGL ES 3.
config_version=5

[application]
config/name="FORTIS: DEEP WATERS"
config/description="Офлайн 3D морской sandbox от FORTIS GAMES. Игровой прототип."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.1.1"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.02, 0.05, 0.09, 1)
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=false

[physics]
common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=8

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0
